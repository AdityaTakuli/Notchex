<Window x:Class="Notchex.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notchex Settings" Width="560" Height="720" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">

    <Window.Resources>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Margin" Value="4,24,0,0"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <Style TargetType="Rectangle" x:Key="Divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource HairlineBrush}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,8,24,24">
        <StackPanel>
            <TextBlock Text="Notchex" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="4,12,0,0"/>
            <TextBlock Style="{StaticResource Hint}" Margin="4,4,0,0"
                       Text="Changes apply right away. Right-click the notch for these options too."/>

            <!-- shape -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="Shape"/>
            <Border Style="{StaticResource Group}" Padding="16,14">
                <StackPanel>
                    <Border Background="#1FFFFFFF" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ShapeNotch" Style="{StaticResource Segment}" Content="Notch" GroupName="shape"/>
                            <RadioButton x:Name="ShapePill" Style="{StaticResource Segment}" Content="Pill" GroupName="shape"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ShapeHint" Style="{StaticResource Hint}" Margin="2,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- size -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="Size"/>
            <Border Style="{StaticResource Group}" Padding="16,8">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Width" VerticalAlignment="Center"/>
                        <Slider x:Name="WidthSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="160" Maximum="380"
                                VerticalAlignment="Center" AutomationProperties.Name="Width"/>
                        <TextBlock x:Name="WidthText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Height" VerticalAlignment="Center"/>
                        <Slider x:Name="HeightSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="28" Maximum="46"
                                VerticalAlignment="Center" AutomationProperties.Name="Height"/>
                        <TextBlock x:Name="HeightText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hub width" VerticalAlignment="Center"/>
                        <Slider x:Name="HubWidthSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="480" Maximum="720"
                                VerticalAlignment="Center" AutomationProperties.Name="Hub width"/>
                        <TextBlock x:Name="HubWidthText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- behavior -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="Behavior"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <CheckBox x:Name="ExpandOnHover">
                        <StackPanel>
                            <TextBlock Text="Open on hover"/>
                            <TextBlock Style="{StaticResource Hint}" Text="When off, click the notch to open it."/>
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="HideInFullScreen">
                        <StackPanel>
                            <TextBlock Text="Hide during full-screen apps"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Games, videos and presentations."/>
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="ShowDate" Content="Show the date when nothing is playing"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="ShowBattery" Content="Show the battery when nothing is playing"/>
                </StackPanel>
            </Border>

            <!-- alerts -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="Alerts in the notch"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <CheckBox x:Name="AlertVolume" Content="Volume changes"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="AlertBattery" Content="Charger and low battery"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="AlertMedia" Content="New song"/>
                </StackPanel>
            </Border>

            <!-- system -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="System"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <CheckBox x:Name="RunAtStartup" Content="Start Notchex when you sign in"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="Hidden" Content="Hide the notch (Notchex keeps running in the tray)"/>
                </StackPanel>
            </Border>

            <!-- shortcuts -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="Shortcuts"/>
            <Border Style="{StaticResource Group}" Padding="16,12">
                <StackPanel>
                    <TextBlock><Run FontWeight="SemiBold">Ctrl + Alt + N</Run><Run Foreground="{StaticResource SecondaryBrush}">   Open or close the notch</Run></TextBlock>
                    <TextBlock Margin="0,8,0,0"><Run FontWeight="SemiBold">Ctrl + Alt + ,</Run><Run Foreground="{StaticResource SecondaryBrush}">   Open these settings</Run></TextBlock>
                    <TextBlock Margin="0,8,0,0"><Run FontWeight="SemiBold">Scroll on the notch</Run><Run Foreground="{StaticResource SecondaryBrush}">   Change the volume</Run></TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,0">
                <TextBlock x:Name="Version" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ResetButton" Style="{StaticResource PlainButton}" Content="Reset to Defaults"/>
                    <Button x:Name="DoneButton" Style="{StaticResource AccentButton}" Content="Done" Margin="10,0,0,0" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
