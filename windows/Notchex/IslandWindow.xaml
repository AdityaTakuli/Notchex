<Window x:Class="Notchex.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notchex"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display">

    <!-- The window is a fixed, mostly empty area at the top of the screen.
         Fully transparent pixels let clicks through, so only the island
         itself catches the mouse. -->
    <Grid x:Name="Root" VerticalAlignment="Top" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center">

            <!-- inverse corners that join the notch to the top edge -->
            <Path x:Name="EarLeft" Fill="{StaticResource IslandBrush}" VerticalAlignment="Top"/>

            <Border x:Name="Island" Background="{StaticResource IslandBrush}" VerticalAlignment="Top"
                    BorderBrush="{StaticResource RimBrush}" Cursor="Hand">
                <Grid x:Name="IslandContent" ClipToBounds="True">

                    <!-- ——— idle: art | clock | bars ——— -->
                    <Grid x:Name="IdleView" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border x:Name="IdleArt" Width="20" Height="20" CornerRadius="5" Background="#33FFFFFF"/>
                            <TextBlock x:Name="IdleDate" FontSize="12" Foreground="{StaticResource SecondaryBrush}"/>
                        </Grid>
                        <TextBlock x:Name="IdleClock" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0"/>
                        <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="Bars" Orientation="Horizontal" Height="14" VerticalAlignment="Center"/>
                            <StackPanel x:Name="IdleBattery" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="IdleBatteryText" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="IdleBatteryIcon" Style="{StaticResource Icon}" FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ——— a short alert: icon + label | value ——— -->
                    <Grid x:Name="AlertView" Margin="16,0" Visibility="Collapsed" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <TextBlock x:Name="AlertIcon" Style="{StaticResource Icon}" FontSize="15"/>
                            <Border x:Name="AlertArt" Width="22" Height="22" CornerRadius="5" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="AlertLabel" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="AlertTrack" Width="110" Height="4" CornerRadius="2" Background="#33FFFFFF"
                                    Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="AlertFill" HorizontalAlignment="Left" CornerRadius="2" Background="White"/>
                            </Border>
                            <TextBlock x:Name="AlertValue" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- ——— the hub ——— -->
                    <StackPanel x:Name="HubView" Margin="18,14,18,16" Visibility="Collapsed" Opacity="0"
                                VerticalAlignment="Top" Cursor="Arrow">
                        <Grid>
                            <TextBlock x:Name="HubClock" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="HubDay" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="HubDate" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- now playing -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HubArt" Width="84" Height="84" CornerRadius="12" Background="#26FFFFFF">
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TertiaryBrush}" x:Name="HubArtPlaceholder"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HubTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="HubArtist" FontSize="12" Foreground="{StaticResource SecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HubElapsed" FontSize="11" Foreground="{StaticResource SecondaryBrush}" MinWidth="34"/>
                                    <Border Grid.Column="1" Height="4" CornerRadius="2" Background="#33FFFFFF" Margin="8,0"
                                            VerticalAlignment="Center" x:Name="HubTrack">
                                        <Border x:Name="HubFill" HorizontalAlignment="Left" CornerRadius="2" Background="White" Width="0"/>
                                    </Border>
                                    <TextBlock x:Name="HubRemaining" Grid.Column="2" FontSize="11" MinWidth="34" TextAlignment="Right"
                                               Foreground="{StaticResource SecondaryBrush}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                                            ToolTip="Previous" AutomationProperties.Name="Previous track"/>
                                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="18"
                                            Width="42" Height="42" Margin="10,0" ToolTip="Play or pause"
                                            AutomationProperties.Name="Play or pause"/>
                                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                                            ToolTip="Next" AutomationProperties.Name="Next track"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- volume and battery -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                                            Content="&#xE767;" ToolTip="Mute" AutomationProperties.Name="Mute"/>
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource ThinSlider}"
                                            Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center"
                                            AutomationProperties.Name="Volume"/>
                                    <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="12" MinWidth="30" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource SecondaryBrush}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="BatteryCard" Grid.Column="2" Style="{StaticResource Card}" MinWidth="120">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="HubBatteryIcon" Style="{StaticResource Icon}" FontSize="16"/>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock x:Name="HubBatteryText" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HubBatteryState" FontSize="11" Foreground="{StaticResource SecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE713;"
                                    Margin="8,0,0,0" ToolTip="Notchex Settings" AutomationProperties.Name="Notchex Settings"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Path x:Name="EarRight" Fill="{StaticResource IslandBrush}" VerticalAlignment="Top"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <ScaleTransform ScaleX="-1"/>
                </Path.RenderTransform>
            </Path>
        </StackPanel>
    </Grid>
</Window>
